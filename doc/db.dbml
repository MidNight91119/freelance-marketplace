Project freelance_marketplace {
    database_type: 'PostgreSQL'
    Note: 'Freelance Marketplace schema'
}

Enum roles {
    client
    freelancer
}

Enum project_status {
    open
    in_progress
    completed
    cancelled
}

Enum proposal_status {
    pending
    accepted
    rejected
}

Enum contract_status {
    active
    completed
    cancelled
}

Table users as u {
    id bigserial [pk]
    name varchar(255) [not null]
    email varchar(255) [not null, unique]
    hashed_password varchar(255) [not null]
    role roles [not null]
    created_at timestamptz [not null, default: `now()`]
}

  Table projects {
    id bigserial [pk]
    client_id bigint [ref: > u.id, not null]
    title varchar(255) [not null]
    description text [not null]
    category varchar(255) [not null]
    budget_min bigint [not null]
    budget_max bigint [not null, note: 'must be >= budget_min']
    status project_status [not null, default: 'open']
    deadline timestamptz [not null, note: 'must be > created_at']
    created_at timestamptz [not null, default: `now()`]
    updated_at timestamptz [not null, default: `now()`]
  }

  Table proposals {
    id bigserial [pk]
    project_id bigint [ref: > projects.id, not null]
    freelancer_id bigint [ref: > u.id, not null]
    cover_letter text [not null]
    proposed_price bigint [not null]
    estimated_duration_days bigint [not null]
    status proposal_status [not null, default: 'pending']
    created_at timestamptz [not null, default: `now()`]
    updated_at timestamptz [not null, default: `now()`]

    indexes {
        (project_id, freelancer_id) [unique]
    }
  }

  Table contracts {
    id bigserial [pk]
    project_id bigint [ref: - projects.id, not null, unique]
    proposal_id bigint [ref: - proposals.id, not null, unique]
    client_id bigint [ref: > u.id, not null]
    freelancer_id bigint [ref: > u.id, not null]
    amount bigint [not null]
    status contract_status [not null, default: 'active']
    created_at timestamptz [not null, default: `now()`]
    updated_at timestamptz [not null, default: `now()`]
  }