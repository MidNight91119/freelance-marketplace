Project freelance_marketplace {
    database_type: 'PostgreSQL'
    Note: 'Freelance Marketplace schema'
}

Enum roles {
    client
    freelancer
}

//   Enum status {
//     open
//     in_progress
//     completed
//     cancelled
//   }

Table users as u {
    id bigserial [pk]
    name varchar(255) [not null]
    email varchar(255) [not null, unique]
    password varchar(255) [not null]
    role roles [not null]
    created_at timestamptz [not null, default: `now()`]
}

